# Virtual host: opens the AIDE baseline-update confirmation gate on outpost.
#
# The report mail links to ssh://aide-update-outpost. The ssh URI scheme carries
# user, host and port and cannot carry a command -- but it resolves Host
# aliases out of this file, and an alias can carry one. So one click lands in
# aide-confirm-update.sh rather than in a shell.
#
# That is deliberate. Making the baseline update inconvenient was never a
# safeguard, only inconvenience; the guarding happens at the far end, where the
# script refuses while anything is suspicious or the report has gone stale,
# prints what is about to be accepted, and only then calls sudo.
#
# RequestTTY is required: sudo prompts for a password at the end, and that
# prompt is the confirmation. No sudo here -- the script runs unprivileged and
# calls sudo itself, once, for the only privileged thing it does.
Host aide-update-outpost
  HostName outpost.schereronline.net
  User michael
  RequestTTY yes
  RemoteCommand /usr/local/sbin/aide-confirm-update.sh

# The local LLM slot on the MacBook Pro, reached from the other machines.
#
# lmx serves whatever model is loaded on 127.0.0.1:8000 there, and that port is
# deliberately never bound to the LAN -- LM Studio offers no authentication of
# any kind, and it remembers a wide bind long after the session that wanted one.
# Forwarding costs the serving side nothing and is authenticated by the same key
# as any other login, so opencode here points at 127.0.0.1:8000 exactly as it
# does there. On the Pro itself the alias resolves to the machine it is already
# on and is simply never used.
#
# ExitOnForwardFailure is the line not to drop as noise: without it ssh connects
# happily when 8000 is already busy on this machine, silently skips the forward,
# and opencode spends the session talking to whatever else holds the port.
# Refusing to connect is the wanted behaviour.
#
# "lmx tunnel" is the way in rather than ssh directly. It wraps "ssh -N lmx"
# -- -N meaning "set up the forwards, run no remote command", which is not a
# flag worth having to remember, and without which you get a login shell and a
# tunnel that dies when you type exit -- and then reports whether anything is
# actually serving at the far end, which the forward itself cannot tell you.
#
# Nothing keeps it up; start it again when it dies. ServerAlive makes that a
# terminal which exits within a minute rather than one that hangs.
Host lmx
  HostName MacBook-Pro.local
  User michael
  LocalForward 8000 127.0.0.1:8000
  ExitOnForwardFailure yes
  ServerAliveInterval 20
  ServerAliveCountMax 3

# Keep Host * last: for any keyword, ssh takes the first value it finds, so a
# catch-all placed above would win over the specific blocks.
Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_rsa

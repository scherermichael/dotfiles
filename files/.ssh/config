# Virtual host: opens the AIDE baseline-update confirmation gate on outpost.
#
# The report mail links to ssh://aide-update-outpost. The ssh URI scheme carries
# user, host and port and cannot carry a command -- but it resolves Host
# aliases out of this file, and an alias can carry one. So one click lands in
# aide-confirm-update.sh rather than in a shell.
#
# That is deliberate. Making the baseline update inconvenient was never a
# safeguard, only inconvenience; the guarding happens at the far end, where the
# script refuses while anything is suspicious or the report has gone stale,
# prints what is about to be accepted, and only then calls sudo.
#
# RequestTTY is required: sudo prompts for a password at the end, and that
# prompt is the confirmation. No sudo here -- the script runs unprivileged and
# calls sudo itself, once, for the only privileged thing it does.
Host aide-update-outpost
  HostName outpost.schereronline.net
  User michael
  RequestTTY yes
  RemoteCommand /usr/local/sbin/aide-confirm-update.sh

# Keep Host * last: for any keyword, ssh takes the first value it finds, so a
# catch-all placed above would win over the specific blocks.
Host *
  IgnoreUnknown UseKeychain
  UseKeychain yes
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_rsa

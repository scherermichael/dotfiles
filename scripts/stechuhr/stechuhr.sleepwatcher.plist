<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>stechuhr.sleepwatcher</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/opt/sleepwatcher/sbin/sleepwatcher</string>
		<string>-s</string>
		<string>"${HOME}/.stechuhr-event" Sleep</string>
		<string>-w</string>
		<string>"${HOME}/.stechuhr-event" Wake-Up</string>
		<string>-S</string>
		<string>"${HOME}/.stechuhr-event" Display-Off</string>
		<string>-W</string>
		<string>"${HOME}/.stechuhr-event" Display-On</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>

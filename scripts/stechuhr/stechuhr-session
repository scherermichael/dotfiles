#!/bin/bash

# Log login and end of the session into the stechuhr log. Started by launchd at login,
# launchd sends SIGTERM on logout, restart and shutdown. A heartbeat recovers the end of
# sessions that ended without SIGTERM (crash, power loss, forced power-off).

heartbeat="${HOME}/.stechuhr-heartbeat"

log_event() {
  local timestamp="${2:-$(date "+%Y-%m-%d %H:%M:%S %z")}"
  # Use the month of the event, not the current one
  echo "${timestamp} Event: $1" >> "${HOME}/.stechuhr-${timestamp:2:5}.log"
}

if [ -s "${heartbeat}" ]; then
  log_event Shutdown-Recovered "$(cat "${heartbeat}")"
fi

trap 'log_event Shutdown; rm -f "${heartbeat}"; exit 0' TERM

log_event Login

# Catch display on/off events, the power management log keeps them for about a week
events="$(pmset -g log | grep 'Display is turned')"
for month in $(echo "${events}" | cut -c1-7 | sort -u); do
  file="${HOME}/.stechuhr-${month:2}.log"
  echo "${events}" | grep "^${month}-" >> "${file}"
  # Sort to avoid out of sequence events and remove events that were copied before
  sort -u -o "${file}" "${file}"
done

while true; do
  date "+%Y-%m-%d %H:%M:%S %z" > "${heartbeat}"
  # Wait in background, so the trap runs immediately on SIGTERM
  sleep 60 &
  wait $!
done

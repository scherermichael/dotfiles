#!/bin/bash

# Log login and end of the session into the stechuhr log. Started by launchd at login,
# launchd sends SIGTERM on logout, restart and shutdown. A heartbeat recovers the end of
# sessions that ended without SIGTERM (crash, power loss, forced power-off).

event="${HOME}/.stechuhr-event"
heartbeat="${HOME}/.stechuhr-heartbeat"

if [ -s "${heartbeat}" ]; then
  "${event}" Shutdown-Recovered "$(cat "${heartbeat}")"
fi

trap '"${event}" Shutdown; rm -f "${heartbeat}"; exit 0' TERM

"${event}" Login
# Catch display events since the last login or wake-up
"${HOME}/.stechuhr-display"

while true; do
  date "+%Y-%m-%d %H:%M:%S %z" > "${heartbeat}"
  # Wait in background, so the trap runs immediately on SIGTERM
  sleep 60 &
  wait $!
done

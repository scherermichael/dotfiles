#!/bin/bash

# Log login and end of the session into the stechuhr log. Started by launchd at login,
# launchd sends SIGTERM on logout, restart and shutdown. A heartbeat recovers the end of
# sessions that ended without SIGTERM (crash, power loss, forced power-off).

event="${HOME}/.stechuhr-event"
heartbeat="${HOME}/.stechuhr-heartbeat"
# Time of SIGTERM in seconds since the epoch, logged on the next start
shutdown="${HOME}/.stechuhr-shutdown"

if [ -s "${shutdown}" ]; then
  "${event}" Shutdown "$(date -r "$(cat "${shutdown}")" "+%Y-%m-%d %H:%M:%S %z")"
elif [ -s "${heartbeat}" ]; then
  "${event}" Shutdown-Recovered "$(cat "${heartbeat}")"
fi
rm -f "${shutdown}"

# Uses shell builtins only, starting processes may fail during shutdown.
# SECONDS counts the seconds since the shell started.
started=$(( $(date +%s) - SECONDS ))
on_term() {
  echo "$(( started + SECONDS ))" > "${shutdown}"
  exit 0
}
trap on_term TERM

"${event}" Login
# Catch power management events since the last login or wake-up
"${HOME}/.stechuhr-powerlog"

while true; do
  date "+%Y-%m-%d %H:%M:%S %z" > "${heartbeat}"
  # Wait in background, so the trap runs immediately on SIGTERM
  sleep 60 &
  wait $!
done
